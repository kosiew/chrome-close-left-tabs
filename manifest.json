{
  "manifest_version": 3,
  "name": "Close Tabs to the Left",
  "version": "1.0.0",
  "description": "Close all tabs to the left of the current tab.",
  "permissions": ["tabs", "contextMenus"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Close Tabs to the Left",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "commands": {
    "close-left-tabs": {
      "suggested_key": {
        "default": "Alt+Shift+Left",
        "mac": "Alt+Shift+Left"
      },
      "description": "Close tabs to the left"
    }
  }
}
